  "news": {
    "n1": {
      "body": "Başkent'te Trafo Spor 3 galibiyetle puan kaybetmeden lider. AYEDAŞ'ta Enerji Tilkileri 7 puanla, Toroslar'da ise Şimşek Ekibi aynı puanla zirvede. Eleme ağacına yükselecek ilk iki sıra için mücadele 4. haftada kızışıyor.",
      "createdAt": 1791101678537,
      "featured": true,
      "tag": "Puan Durumu",
      "title": "4. Hafta öncesi tablo: Üç bölgede de zirve netleşiyor"
    },
    "n2": {
      "body": "Başkent bölgesinde oynanan karşılaşmada Amper Yıldızları, iç sahada Topraklama FC'yi 2-1 geriye düşürdü. Maçın sonucu, bölgenin alt sıralarındaki puan farkını doğrudan etkileyecek.",
      "createdAt": 1791015278537,
      "featured": false,
      "tag": "Canlı Skor",
      "title": "Canlı: Amper Yıldızları, Topraklama FC karşısında 67. dakikada 2-1 önde"
    },
    "n3": {
      "body": "Toroslar bölgesinde her iki takımın da henüz galibiyeti yok. Adana Küme Sahası'ndaki karşılaşmanın kaybedeni, bölgede son sırada 4. haftayı tamamlayacak.",
      "createdAt": 1790928878537,
      "featured": false,
      "tag": "Fikstür",
      "title": "Toroslar'da kritik randevu: Güç Hattı - Gerilim Hattı bu akşam 20:30'da"
    },
    "n4": {
      "body": "Enerji Tilkileri'nin kaptanı Ahmet Yıldırım, attığı 6 golle turnuvanın gol krallığı sıralamasında ilk sırada. Derya Kaplan (Şimşek Ekibi) 5 asistle asist tablosunun lideri.",
      "createdAt": 1790842478537,
      "featured": false,
      "tag": "Oyuncu",
      "title": "Gol kralı yarışında Ahmet Yıldırım 6 golle önde"
    },
    "n5": {
      "body": "Enerjisa Sahada portalına yeni bir özellik eklendi: takım yöneticileri artık oyuncu ve takım profillerine fotoğraf yükleyebiliyor. Fotoğraflar oyuncu kartlarında ve maç ekranlarında otomatik olarak görünüyor.",
      "createdAt": 1790756078537,
      "featured": false,
      "tag": "Duyuru",
      "title": "Portal güncellemesi: Oyuncu ve takım profillerine fotoğraf eklendi"
    }
